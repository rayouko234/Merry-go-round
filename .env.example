# Merry-Go-Round environment template (.env.example)
#
# NOTE: this project's runtime configuration is NOT loaded from .env files.
# The values below are placeholders documenting where configuration lives.

# --- Firebase (app/google-services.json is generated per Firebase project) ---
# Project id:      mt-project-ce4c0        (.firebaserc)
# Android package: com.example.merrygoround (app/google-services.json)
FIREBASE_PROJECT_ID=mt-project-ce4c0

# --- Backend mode (gradle.properties, not .env) ---
# mgr.backendMode=firebase     # default: Firebase Auth + Cloud Firestore
# mgr.backendMode=local        # offline Room-backed demo store

# --- Firebase CLI (used by `firebase deploy` / `emulators:start`) ---
# Set via `firebase login` or:  FIREBASE_TOKEN=<your-ci-token>
# FIREBASE_TOKEN=

# Never commit real tokens. This file contains placeholders only.
